{
  "manifest_id": "R108-A-SMB-FUNCTIONAL-LANGUAGE-v1",
  "schema_version": "r108-language-cases-v1",
  "frozen": true,
  "cases": [
    {"case_id": "dynamic-en-00", "instruction": "Make a playable Mario level where Mario kills no enemies, collects exactly five coins, and performs exactly two ground jumps.", "expected": {"status": "resolved", "domain": "smb_dynamic", "constraints": {"enemies": {"relation": "exact", "value": 0}, "coins": {"relation": "exact", "value": 5}, "jumps": {"relation": "exact", "value": 2}}}},
    {"case_id": "dynamic-zh-01", "instruction": "做一个动态马里奥关卡：实际游戏中正好击杀三个敌人、收集四枚金币，并且只发生一次地面跳跃。", "expected": {"status": "resolved", "domain": "smb_dynamic", "constraints": {"enemies": {"relation": "exact", "value": 3}, "coins": {"relation": "exact", "value": 4}, "jumps": {"relation": "exact", "value": 1}}}},
    {"case_id": "dynamic-en-02", "instruction": "Mario should eliminate a trio of enemies and pick up two coins, without making any counted ground jump.", "expected": {"status": "resolved", "domain": "smb_dynamic", "constraints": {"enemies": {"relation": "exact", "value": 3}, "coins": {"relation": "exact", "value": 2}, "jumps": {"relation": "exact", "value": 0}}}},
    {"case_id": "dynamic-zh-03", "instruction": "以模拟器记录为准：两次 counted kill，一枚实际收集的金币，三次 ground jump。", "expected": {"status": "resolved", "domain": "smb_dynamic", "constraints": {"enemies": {"relation": "exact", "value": 2}, "coins": {"relation": "exact", "value": 1}, "jumps": {"relation": "exact", "value": 3}}}},
    {"case_id": "dynamic-en-04", "instruction": "I want four ground jumps, zero collected coins, and exactly one enemy defeated during play.", "expected": {"status": "resolved", "domain": "smb_dynamic", "constraints": {"enemies": {"relation": "exact", "value": 1}, "coins": {"relation": "exact", "value": 0}, "jumps": {"relation": "exact", "value": 4}}}},
    {"case_id": "dynamic-zh-05", "instruction": "不要杀敌，也不要收金币；Mario 必须正好完成五次地面跳跃。", "expected": {"status": "resolved", "domain": "smb_dynamic", "constraints": {"enemies": {"relation": "exact", "value": 0}, "coins": {"relation": "exact", "value": 0}, "jumps": {"relation": "exact", "value": 5}}}},
    {"case_id": "dynamic-preference-06", "instruction": "Kill at least two enemies, collect exactly three coins, and use as few ground jumps as possible.", "expected": {"status": "resolved", "domain": "smb_dynamic", "constraints": {"enemies": {"relation": "min", "value": 2}, "coins": {"relation": "exact", "value": 3}}, "objectives": [{"metric": "jumps", "direction": "minimize"}]}},
    {"case_id": "dynamic-range-07", "instruction": "During gameplay, defeat no more than one enemy, collect at least four coins, and jump exactly twice.", "expected": {"status": "resolved", "domain": "smb_dynamic", "constraints": {"enemies": {"relation": "max", "value": 1}, "coins": {"relation": "min", "value": 4}, "jumps": {"relation": "exact", "value": 2}}}},
    {"case_id": "dynamic-search-jump-08", "instruction": "Mario must finish with zero kills, five collected coins, and five ground jumps.", "disabled_backbones": ["k0_j5"], "max_evaluator_calls": 8, "expected": {"status": "resolved", "domain": "smb_dynamic", "constraints": {"enemies": {"relation": "exact", "value": 0}, "coins": {"relation": "exact", "value": 5}, "jumps": {"relation": "exact", "value": 5}}}},
    {"case_id": "dynamic-search-stomp-09", "instruction": "Create a played outcome of exactly three enemy kills and three collected coins with no ground jumps.", "disabled_backbones": ["k3_j0"], "max_evaluator_calls": 8, "expected": {"status": "resolved", "domain": "smb_dynamic", "constraints": {"enemies": {"relation": "exact", "value": 3}, "coins": {"relation": "exact", "value": 3}, "jumps": {"relation": "exact", "value": 0}}}},
    {"case_id": "static-en-10", "instruction": "In the static SMB tile grid, place exactly four valid pipes, six enemy tiles, five coin tiles, and thirty-two block tiles. Do not interpret these as gameplay outcomes.", "expected": {"status": "resolved", "domain": "smb_static", "constraints": {"pipe_count": {"relation": "exact", "value": 4}, "enemy_tile_count": {"relation": "exact", "value": 6}, "coin_tile_count": {"relation": "exact", "value": 5}, "block_tile_count": {"relation": "exact", "value": 32}}}},
    {"case_id": "static-zh-11", "instruction": "这是静态 tile-count 任务，不运行 Mario：水管正好两个，敌人 tile 三个，金币 tile 四个，block tile 十二个。", "expected": {"status": "resolved", "domain": "smb_static", "constraints": {"pipe_count": {"relation": "exact", "value": 2}, "enemy_tile_count": {"relation": "exact", "value": 3}, "coin_tile_count": {"relation": "exact", "value": 4}, "block_tile_count": {"relation": "exact", "value": 12}}}},
    {"case_id": "static-zero-12", "instruction": "For the static content grid, use zero pipes, zero enemy tiles, zero coin tiles, and zero blocks.", "expected": {"status": "resolved", "domain": "smb_static", "constraints": {"pipe_count": {"relation": "exact", "value": 0}, "enemy_tile_count": {"relation": "exact", "value": 0}, "coin_tile_count": {"relation": "exact", "value": 0}, "block_tile_count": {"relation": "exact", "value": 0}}}},
    {"case_id": "static-synonym-13", "instruction": "The level file itself should contain one pipe component, two enemy sprites as tiles, six C tiles, and twenty solid/brick/question blocks.", "expected": {"status": "resolved", "domain": "smb_static", "constraints": {"pipe_count": {"relation": "exact", "value": 1}, "enemy_tile_count": {"relation": "exact", "value": 2}, "coin_tile_count": {"relation": "exact", "value": 6}, "block_tile_count": {"relation": "exact", "value": 20}}}},
    {"case_id": "static-preference-14", "instruction": "Use at least two static pipe components and exactly three enemy tiles. Keep blocks at no more than sixteen and maximize the number of coin tiles.", "expected": {"status": "resolved", "domain": "smb_static", "constraints": {"pipe_count": {"relation": "min", "value": 2}, "enemy_tile_count": {"relation": "exact", "value": 3}, "block_tile_count": {"relation": "max", "value": 16}}, "objectives": [{"metric": "coin_tile_count", "direction": "maximize"}]}},
    {"case_id": "static-partial-15", "instruction": "This is about the static grid: place exactly two enemy tiles and exactly three coin tiles; the other tile-count metrics may be chosen freely.", "expected": {"status": "resolved", "domain": "smb_static", "constraints": {"enemy_tile_count": {"relation": "exact", "value": 2}, "coin_tile_count": {"relation": "exact", "value": 3}}}},
    {"case_id": "guard-vague-dynamic-16", "instruction": "Make Mario collect a few coins and jump a sensible number of times.", "expected": {"status": "needs_clarification", "domain": "smb_dynamic"}},
    {"case_id": "guard-conflict-17", "instruction": "Mario must collect exactly two coins and exactly three coins in the same playthrough.", "expected": {"status": "needs_clarification", "domain": "smb_dynamic"}},
    {"case_id": "guard-no-numbers-18", "instruction": "Build me a fun Mario level with a nice balance of enemies, coins, and jumping.", "expected": {"status": "needs_clarification", "domain": "smb_dynamic"}},
    {"case_id": "guard-other-domain-19", "instruction": "Create a Zelda dungeon with one key, one locked door, and two enemies.", "expected": {"status": "unsupported", "domain": "unknown"}},
    {"case_id": "guard-vague-static-20", "instruction": "Put several pipes and plenty of blocks into the static SMB grid.", "expected": {"status": "needs_clarification", "domain": "smb_static"}},
    {"case_id": "guard-out-of-range-21", "instruction": "During gameplay Mario must kill exactly ten enemies, collect two coins, and jump once.", "expected": {"status": "unsupported", "domain": "smb_dynamic"}},
    {"case_id": "dynamic-partial-22", "instruction": "During actual play, collect exactly three coins. I do not care how many enemies are killed or how many times Mario jumps.", "expected": {"status": "resolved", "domain": "smb_dynamic", "constraints": {"coins": {"relation": "exact", "value": 3}}}},
    {"case_id": "static-range-23", "instruction": "For static tile counts, use at most one pipe, at least four enemy tiles, exactly two coin tiles, and no more than eight blocks.", "expected": {"status": "resolved", "domain": "smb_static", "constraints": {"pipe_count": {"relation": "max", "value": 1}, "enemy_tile_count": {"relation": "min", "value": 4}, "coin_tile_count": {"relation": "exact", "value": 2}, "block_tile_count": {"relation": "max", "value": 8}}}}
  ]
